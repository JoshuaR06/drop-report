<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- "Night broadcast": a sports-TV scoreboard. Near-black, tall condensed numbers, one amber accent.
       Chart pairs pass the dataviz checks (dark: #BC7F1E + #3592D6 on #0E0F13; light: #C0680F + #2D6BB3 on #F4F3EF). -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PageBrush" Color="#0E0F13" />
      <SolidColorBrush x:Key="NavBrush" Color="#0A0B0E" />
      <SolidColorBrush x:Key="CardBrush" Color="#16171C" />
      <SolidColorBrush x:Key="Card2Brush" Color="#1C1D23" />
      <SolidColorBrush x:Key="LineBrush" Color="#2A2B31" />
      <SolidColorBrush x:Key="GridBrush" Color="#1F2026" />
      <SolidColorBrush x:Key="InkBrush" Color="#ECEAE5" />
      <SolidColorBrush x:Key="Ink2Brush" Color="#B4B1AA" />
      <SolidColorBrush x:Key="MutedBrush" Color="#85837D" />
      <SolidColorBrush x:Key="AccentBrush" Color="#F2A93B" />
      <SolidColorBrush x:Key="HeroBrush" Color="#F2A93B" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#221B10" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#0E0F13" />
      <SolidColorBrush x:Key="RuleBrush" Color="#F2A93B" />
      <SolidColorBrush x:Key="Series1Brush" Color="#BC7F1E" />
      <SolidColorBrush x:Key="Series2Brush" Color="#3592D6" />
      <SolidColorBrush x:Key="WashBrush" Color="#22BC7F1E" />
      <SolidColorBrush x:Key="WatermarkBrush" Color="#08F2A93B" />
      <SolidColorBrush x:Key="RarityCommon" Color="#A3AAB8" />
      <SolidColorBrush x:Key="RarityUncommon" Color="#4ADE80" />
      <SolidColorBrush x:Key="RarityRare" Color="#60A5FA" />
      <SolidColorBrush x:Key="RarityEpic" Color="#C084FC" />
      <SolidColorBrush x:Key="RarityLegendary" Color="#FB923C" />
      <SolidColorBrush x:Key="RarityMythic" Color="#FACC15" />
      <SolidColorBrush x:Key="RarityExotic" Color="#22D3EE" />
      <SolidColorBrush x:Key="MapMeBrush" Color="#F2A93B" />
      <SolidColorBrush x:Key="MapMateBrush" Color="#4FC3D9" />
      <SolidColorBrush x:Key="MapOtherBrush" Color="#8A93A8" />
      <SolidColorBrush x:Key="MapOpenedBrush" Color="#7BD389" />
      <SolidColorBrush x:Key="MapBrokenBrush" Color="#F08A4B" />
      <SolidColorBrush x:Key="MapKillBrush" Color="#F26B5B" />
      <SolidColorBrush x:Key="MapStormBrush" Color="#B79CFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PageBrush" Color="#F4F3EF" />
      <SolidColorBrush x:Key="NavBrush" Color="#EAE8E2" />
      <SolidColorBrush x:Key="CardBrush" Color="#FBFAF7" />
      <SolidColorBrush x:Key="Card2Brush" Color="#F7F6F2" />
      <SolidColorBrush x:Key="LineBrush" Color="#D6D3CB" />
      <SolidColorBrush x:Key="GridBrush" Color="#E4E1DA" />
      <SolidColorBrush x:Key="InkBrush" Color="#15161A" />
      <SolidColorBrush x:Key="Ink2Brush" Color="#45464C" />
      <SolidColorBrush x:Key="MutedBrush" Color="#76746E" />
      <SolidColorBrush x:Key="AccentBrush" Color="#A85A00" />
      <SolidColorBrush x:Key="HeroBrush" Color="#15161A" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#F1E4CF" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FBFAF7" />
      <SolidColorBrush x:Key="RuleBrush" Color="#C0680F" />
      <SolidColorBrush x:Key="Series1Brush" Color="#C0680F" />
      <SolidColorBrush x:Key="Series2Brush" Color="#2D6BB3" />
      <SolidColorBrush x:Key="WashBrush" Color="#18C0680F" />
      <SolidColorBrush x:Key="WatermarkBrush" Color="#0AA85A00" />
      <SolidColorBrush x:Key="RarityCommon" Color="#7B8494" />
      <SolidColorBrush x:Key="RarityUncommon" Color="#15803D" />
      <SolidColorBrush x:Key="RarityRare" Color="#1D4ED8" />
      <SolidColorBrush x:Key="RarityEpic" Color="#7E22CE" />
      <SolidColorBrush x:Key="RarityLegendary" Color="#C2410C" />
      <SolidColorBrush x:Key="RarityMythic" Color="#A16207" />
      <SolidColorBrush x:Key="RarityExotic" Color="#0E7490" />
      <SolidColorBrush x:Key="MapMeBrush" Color="#C2410C" />
      <SolidColorBrush x:Key="MapMateBrush" Color="#0E7490" />
      <SolidColorBrush x:Key="MapOtherBrush" Color="#5B6375" />
      <SolidColorBrush x:Key="MapOpenedBrush" Color="#15803D" />
      <SolidColorBrush x:Key="MapBrokenBrush" Color="#C2410C" />
      <SolidColorBrush x:Key="MapKillBrush" Color="#B91C1C" />
      <SolidColorBrush x:Key="MapStormBrush" Color="#6D28D9" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="DisplayFont">avares://DropReport/Assets/Fonts#Barlow Condensed</FontFamily>
  <FontFamily x:Key="TextFont">avares://DropReport/Assets/Fonts#Inter</FontFamily>
  <FontWeight x:Key="DisplayWeight">Bold</FontWeight>
  <FontWeight x:Key="StatWeight">SemiBold</FontWeight>
  <FontStyle x:Key="HeroHeadlineStyle">Normal</FontStyle>
  <x:Double x:Key="DisplayLetterSpacing">0.2</x:Double>
  <x:Double x:Key="HeroSize">128</x:Double>
  <x:Double x:Key="DisplaySize">48</x:Double>
  <x:Double x:Key="HeroHeadlineSize">32</x:Double>
  <x:Double x:Key="HeadlineSize">27</x:Double>
  <x:Double x:Key="HeadlineSmallSize">21</x:Double>
  <x:Double x:Key="StatSize">40</x:Double>
  <x:Double x:Key="RowStatSize">30</x:Double>
  <x:Double x:Key="DayNumSize">44</x:Double>
  <x:Double x:Key="NavTitleSize">20</x:Double>
  <x:Double x:Key="BrandSize">28</x:Double>
  <x:Double x:Key="RuleHeight">2</x:Double>
  <x:String x:Key="LookName">Night broadcast</x:String>
</ResourceDictionary>
