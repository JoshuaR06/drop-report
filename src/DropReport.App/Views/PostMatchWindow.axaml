<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DropReport.App.ViewModels"
        xmlns:c="using:DropReport.App.Controls"
        x:Class="DropReport.App.Views.PostMatchWindow"
        x:DataType="vm:PostMatchViewModel"
        Title="Drop Report: match report" Width="440" SizeToContent="Height"
        WindowDecorations="None" Topmost="True" ShowActivated="False" ShowInTaskbar="False" CanResize="False"
        Background="Transparent" TransparencyLevelHint="Transparent" Icon="/Assets/dropreport.ico">
  <Window.Styles>
    <Style Selector="TextBlock.delta"><Setter Property="FontSize" Value="10.5" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.delta.better"><Setter Property="Foreground" Value="{DynamicResource MapOpenedBrush}" /></Style>
    <Style Selector="TextBlock.delta.worse"><Setter Property="Foreground" Value="{DynamicResource MapKillBrush}" /></Style>
  </Window.Styles>
  <Border x:Name="Card" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,3,0,0">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
      </Transitions>
    </Border.Transitions>
    <Panel>
      <c:Stripes />
      <StackPanel Margin="18,12,18,16" Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Data="{StaticResource BrandMark}" Fill="{DynamicResource AccentBrush}" Width="12" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Kicker}" Classes="kicker" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Classes="link" Command="{Binding CloseCommand}" Padding="6,0" HorizontalAlignment="Right" ToolTip.Tip="Dismiss">
            <TextBlock Text="✕" Classes="muted" />
          </Button>
        </Grid>
        <TextBlock Text="{Binding Headline}" Classes="headline" FontSize="26" Margin="0,2,0,0" />
        <ItemsControl ItemsSource="{Binding Stats}" Margin="0,8,0,4">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VersusLine">
              <StackPanel Spacing="0">
                <TextBlock Text="{Binding Label}" Classes="label" FontSize="9.5" />
                <c:Ticker Value="{Binding Value}" Classes="stat" FontSize="32" />
                <TextBlock Text="{Binding Delta}" Classes="note delta" Classes.better="{Binding IsBetter}" Classes.worse="{Binding IsWorse}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Records}" IsVisible="{Binding HasRecords}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Background="{DynamicResource AccentBrush}" Padding="10,3" Margin="0,2" HorizontalAlignment="Left">
                <Border.RenderTransform><SkewTransform AngleX="-12" /></Border.RenderTransform>
                <TextBlock Text="{Binding}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource OnAccentBrush}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding TokenLine}" IsVisible="{Binding HasToken}" Classes="sub" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
          <TextBlock Text="{Binding Dek}" Classes="note" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Grid.Column="1" Classes="gold" Content="Open report" Command="{Binding OpenCommand}" />
        </Grid>
      </StackPanel>
    </Panel>
  </Border>
</Window>
