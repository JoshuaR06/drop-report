<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DropReport.App.ViewModels"
             xmlns:c="using:DropReport.App.Controls"
             x:Class="DropReport.App.Views.WeaponsView"
             x:DataType="vm:WeaponsViewModel">
  <ScrollViewer>
    <StackPanel Margin="48,34,48,40" MaxWidth="1180">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Text="{Binding Dateline}" Classes="kicker" VerticalAlignment="Bottom" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Main.Filter.Seasons}" SelectedItem="{Binding Main.Filter.Season}" MinWidth="176" />
          <ComboBox ItemsSource="{Binding Main.Filter.Modes}" SelectedItem="{Binding Main.Filter.Mode}" MinWidth="124" />
        </StackPanel>
      </Grid>
      <Border Classes="goldrule" />
      <TextBlock Text="What you're best with" Classes="display" Margin="0,16,0,4" />
      <TextBlock Text="Ranked from your own fights. A weapon needs enough use to make a list, so one lucky match can't top it." Classes="dek" Margin="0,0,0,8" />

      <!-- picks -->
      <Label Classes="section" Content="YOUR BEST" />
      <ItemsControl ItemsSource="{Binding Picks}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PickCard">
            <Border Classes="pick" Padding="0">
              <StackPanel>
                <Border Height="4" Background="{Binding Rarity, Converter={x:Static vm:RarityOrAccentConverter.Instance}}" />
                <StackPanel Spacing="2" Margin="18,12,18,16">
                  <TextBlock Text="{Binding Title}" Classes="kicker" />
                  <TextBlock Text="{Binding Name}" Classes="headlineSmall" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <c:Ticker Value="{Binding Value}" Classes="pickValue" />
                  <TextBlock Text="{Binding Detail}" Classes="note" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- weapon types -->
      <Label Classes="section" Content="WHAT WINS YOUR FIGHTS" />
      <ItemsControl ItemsSource="{Binding Classes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MeterLine">
            <Grid ColumnDefinitions="150,*,70,320" Margin="0,5">
              <TextBlock Text="{Binding Name}" Classes="rowname" />
              <c:Meter Grid.Column="1" Value="{Binding Fill}" Height="10" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="cellnum lead" FontSize="22" />
              <TextBlock Grid.Column="3" Text="{Binding Detail}" Classes="note" VerticalAlignment="Center" Margin="18,0,0,0" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="note" Margin="0,8,0,0" Text="Share of your knocks and eliminations, from Epic's elimination events (complete). Typical = the median distance." />

      <!-- the table -->
      <Label Classes="section" Content="EVERY WEAPON" />
      <Grid ColumnDefinitions="*,70,70,100,70,90,80,80" Margin="0,0,0,6">
        <TextBlock Classes="label" Text="WEAPON" />
        <TextBlock Classes="label num" Grid.Column="1" Text="ELIMS" />
        <TextBlock Classes="label num" Grid.Column="2" Text="KNOCKS" />
        <TextBlock Classes="label num" Grid.Column="3" Text="DMG/MATCH" />
        <TextBlock Classes="label num" Grid.Column="4" Text="HITS" />
        <TextBlock Classes="label num" Grid.Column="5" Text="HEADSHOT" />
        <TextBlock Classes="label num" Grid.Column="6" Text="RANGE" />
        <TextBlock Classes="label num" Grid.Column="7" Text="MATCHES" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WeaponLine">
            <Border Classes="rowline">
              <Grid ColumnDefinitions="*,70,70,100,70,90,80,80">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="rarity" Background="{Binding Rarity, Converter={x:Static vm:RarityBrushConverter.Instance}}" />
                  <TextBlock Text="{Binding Name}" Classes="rowname" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Elims}" Classes="cellnum lead" />
                <TextBlock Grid.Column="2" Text="{Binding Knocks}" Classes="cellnum" />
                <TextBlock Grid.Column="3" Text="{Binding DamagePerMatch}" Classes="cellnum" />
                <TextBlock Grid.Column="4" Text="{Binding Hits}" Classes="cellnum" />
                <TextBlock Grid.Column="5" Text="{Binding Hs}" Classes="cellnum" />
                <TextBlock Grid.Column="6" Text="{Binding Range}" Classes="cellnum" />
                <TextBlock Grid.Column="7" Text="{Binding Matches}" Classes="cellnum" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
        <ToggleSwitch IsChecked="{Binding ShowAll}" OnContent="Showing every weapon" OffContent="Hiding barely-used weapons" />
        <TextBlock Text="{Binding TableNote}" Classes="note" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="note" Margin="0,6,0,0" MaxWidth="860" HorizontalAlignment="Left"
                 Text="The colored bar is the best rarity you used. Damage and headshots only count hits the replay recorded in detail: slingshot hits arrive blank and melee items send none, so those show a dash." />

      <!-- deaths -->
      <Label Classes="section" Content="WHAT TAKES YOU OUT" />
      <TextBlock Classes="dek" Text="{Binding DeathSummary}" Margin="0,0,0,10" />
      <ItemsControl ItemsSource="{Binding Deaths}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CountLine">
            <Border Classes="rowline">
              <Grid ColumnDefinitions="220,*,80">
                <TextBlock Text="{Binding Name}" Classes="rowname" />
                <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="sub" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="cellnum lead" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
