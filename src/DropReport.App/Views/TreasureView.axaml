<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DropReport.App.ViewModels"
             xmlns:c="using:DropReport.App.Controls"
             x:Class="DropReport.App.Views.TreasureView"
             x:DataType="vm:TreasureViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="StatCell" x:DataType="vm:Tile">
      <Border Classes="cell" Width="182" Margin="0,0,0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Label}" Classes="label" />
          <c:Ticker Value="{Binding Value}" Classes="stat" />
          <TextBlock Text="{Binding Note}" Classes="note" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MeterRow" x:DataType="vm:MeterLine">
      <Border Classes="rowline" Padding="0,10">
        <Grid ColumnDefinitions="*,70" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Text="{Binding Name}" Classes="rowname" FontSize="18" />
          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="cellnum lead" FontSize="22" />
          <c:Meter Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Fill}" Margin="0,6,0,4" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Classes="note" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CountRow" x:DataType="vm:CountLine">
      <Border Classes="rowline">
        <Grid ColumnDefinitions="*,Auto,56">
          <StackPanel Orientation="Horizontal">
            <Border Classes="rarity" Background="{Binding Rarity, Converter={x:Static vm:RarityBrushConverter.Instance}}" />
            <TextBlock Text="{Binding Name}" Classes="rowname" FontSize="17" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="muted" VerticalAlignment="Center" Margin="10,0" />
          <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="cellnum lead" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="48,34,48,40" MaxWidth="1180">
      <TextBlock Text="{Binding Dateline}" Classes="kicker" Margin="0,0,0,10" />
      <Border Classes="goldrule" />

      <!-- hero: your chance so far -->
      <Panel Margin="0,10,0,0">
        <c:Stripes />
        <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,10">
          <c:Ticker Value="{Binding Hero}" Classes="hero" VerticalAlignment="Center" Margin="0,-10,32,-10" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="chance you've rolled the Pirate Shop token" Classes="heroHeadline" />
            <TextBlock Text="{Binding ProjectedText}" Classes="headlineSmall" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding HeroDek}" Classes="dek" />
          </StackPanel>
        </Grid>
      </Panel>

      <!-- the curve -->
      <c:ChanceCurve Height="290" Margin="0,8,0,4" PerChest="{Binding PerChest}" Current="{Binding Current}" CurrentChance="{Binding CurrentChance}"
                     Projected="{Binding Projected}" ProjectedChance="{Binding ProjectedChance}" ProjectedLabel="{Binding ProjectedLabel}" />
      <TextBlock Classes="note" Text="Each chest is an independent roll, so the chance climbs slowly and never reaches 100%. Hover the chart for any chest count." />

      <Label Classes="section" Content="YOUR CHESTS" />
      <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource StatCell}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>

      <Label Classes="section" Content="CHESTS NEEDED FOR" />
      <ItemsControl ItemsSource="{Binding Milestones}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:Tile">
            <Border Classes="pick" Width="300">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Label}" Classes="kicker" />
                <c:Ticker Value="{Binding Value}" Classes="pickValue" />
                <TextBlock Text="chests in total" Classes="note" />
                <TextBlock Text="{Binding Note}" Classes="sub" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Treasure Hours -->
      <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Background="{DynamicResource AccentSoftBrush}" Padding="18,14" Margin="0,8,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,8,14,0" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding BoostTitle}" Classes="headlineSmall" />
            <TextBlock Text="{Binding BoostDetail}" Classes="dek" FontSize="14" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- counting rules -->
      <Label Classes="section" Content="WHAT COUNTS" />
      <TextBlock Classes="dek" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,10"
                 Text="Epic hasn't said whether refilled or broken chests roll for rewards, or whether a teammate's token reaches the whole squad. Pick what you believe; every number on this page follows." />
      <WrapPanel>
        <ToggleSwitch IsChecked="{Binding CountRefills}" OnContent="Refilled chests count" OffContent="Refilled chests don't count" Margin="0,0,36,0" />
        <ToggleSwitch IsChecked="{Binding CountBroken}" OnContent="Broken chests count" OffContent="Broken chests don't count" Margin="0,0,36,0" />
        <ToggleSwitch IsChecked="{Binding CountTeam}" OnContent="Teammates' chests count" OffContent="Only my chests count" />
      </WrapPanel>
      <TextBlock Classes="note" Margin="0,6,0,0" MaxWidth="860" HorizontalAlignment="Left"
                 Text="Refilled = a chest searched earlier in the same match (chests refill over time since v43.00). Only chests roll: extraction crates and ammo boxes never count. Teammates out of your sight aren't in your replay, so team counts are a minimum." />

      <!-- the other rewards -->
      <Label Classes="section" Content="THE OTHER CHEST REWARDS" />
      <Grid ColumnDefinitions="*,48,*">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Rewards}" ItemTemplate="{StaticResource MeterRow}" />
          <TextBlock Classes="note" Margin="0,8,0,0" Text="Weekly rewards rotate, and you can't get the same one twice, so the weekly chance is what a fresh one looks like each week at your pace." />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="CHESTS BY TYPE" Classes="kicker" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding ChestTypes}" ItemTemplate="{StaticResource MeterRow}" />
        </StackPanel>
      </Grid>

      <Label Classes="section" Content="WHAT THE CHESTS GAVE YOU" />
      <Grid ColumnDefinitions="*,48,*">
        <StackPanel>
          <TextBlock Text="SEASON ITEMS YOU PICKED UP" Classes="kicker" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding SeasonItems}" ItemTemplate="{StaticResource CountRow}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="LOOT YOU TOOK MOST" Classes="kicker" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding Loot}" ItemTemplate="{StaticResource CountRow}" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="note" Margin="0,22,0,0" MaxWidth="860" HorizontalAlignment="Left"
                 Text="Odds from Epic's post on Fortnite Status (7 Nov 2026). The token can be found until the season ends on 5 Dec. Drop Report can't see whether you got a reward: that's on Epic's servers, not in your replays." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
