<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DropReport.App.ViewModels"
             x:Class="DropReport.App.Views.MatchesView"
             x:DataType="vm:MatchesViewModel">
  <DockPanel Margin="48,34,48,24">
    <StackPanel DockPanel.Dock="Top">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Text="{Binding Dateline}" Classes="kicker" VerticalAlignment="Bottom" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Main.Filter.Seasons}" SelectedItem="{Binding Main.Filter.Season}" MinWidth="176" />
          <ComboBox ItemsSource="{Binding Main.Filter.Modes}" SelectedItem="{Binding Main.Filter.Mode}" MinWidth="124" />
        </StackPanel>
      </Grid>
      <Border Classes="goldrule" />
      <TextBlock Text="Every match, newest first" Classes="display" Margin="0,20,0,4" />
      <TextBlock Text="Open a match to replay it on the island map." Classes="dek" Margin="0,0,0,18" />
    </StackPanel>
    <ListBox Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" MaxWidth="1180" HorizontalAlignment="Left">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LogEntry">
          <Border Classes="rowline" Padding="4,16,22,16">
            <Grid ColumnDefinitions="76,*,90,90,90">
              <!-- date block -->
              <StackPanel VerticalAlignment="Top">
                <TextBlock Text="{Binding Day}" Classes="daynum" />
                <TextBlock Text="{Binding Month}" Classes="kicker" />
                <TextBlock Text="{Binding Time}" Classes="note" />
              </StackPanel>
              <!-- story -->
              <StackPanel Grid.Column="1" Spacing="4" Margin="8,2,24,0">
                <TextBlock Text="{Binding Kicker}" Classes="label" />
                <TextBlock Text="{Binding Headline}" Classes="headline" />
                <TextBlock Text="{Binding Dek}" Classes="dek" FontSize="14" />
              </StackPanel>
              <!-- figures -->
              <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,4,0,0">
                <TextBlock Text="PLACE" Classes="label" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Place}" Classes="rowstat" />
              </StackPanel>
              <StackPanel Grid.Column="3" HorizontalAlignment="Right" Margin="0,4,0,0">
                <TextBlock Text="ELIMS" Classes="label" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Elims}" Classes="rowstat" />
              </StackPanel>
              <StackPanel Grid.Column="4" HorizontalAlignment="Right" Margin="0,4,0,0">
                <TextBlock Text="CHESTS" Classes="label" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Chests}" Classes="rowstat" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
