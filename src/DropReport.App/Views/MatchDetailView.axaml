<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DropReport.App.ViewModels"
             xmlns:c="using:DropReport.App.Controls"
             x:Class="DropReport.App.Views.MatchDetailView"
             x:DataType="vm:MatchDetailViewModel">
  <Grid Margin="40,28,40,24" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,28,380">
    <!-- header: dateline, headline, dek -->
    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Text="{Binding Subtitle}" Classes="kicker" VerticalAlignment="Bottom" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="gold" Content="Share card" Command="{Binding ShareCommand}" ToolTip.Tip="Copies an image of this match you can paste into Discord" />
        <Button Classes="ghost" Command="{Binding BackCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72B;" VerticalAlignment="Center" FontSize="12" />
            <TextBlock Text="Match Log" />
          </StackPanel>
        </Button>
        </StackPanel>
      </Grid>
      <Border Classes="goldrule" />
      <TextBlock Text="{Binding Title}" Classes="display" Margin="0,16,0,4" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Dek}" Classes="dek" MaxWidth="900" HorizontalAlignment="Left" />
      <Border IsVisible="{Binding HasTreasure}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left" MaxWidth="900">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="TREASURE" Classes="kicker" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TreasureNote}" TextWrapping="Wrap" MaxWidth="780" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding ElimCheck}" IsVisible="{Binding HasElimCheck}" Classes="note" MaxWidth="900" HorizontalAlignment="Left" Margin="0,6,0,0" />
      <TextBlock Text="{Binding ConnectionNote}" IsVisible="{Binding HasConnection}" Classes="note" MaxWidth="900" HorizontalAlignment="Left" Margin="0,2,0,0" />
    </StackPanel>

    <!-- scoreboard strip -->
    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Tiles}" Margin="0,0,0,18">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:Tile">
          <Border Classes="cell" Width="182">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Label}" Classes="label" />
              <TextBlock Text="{Binding Value}" Classes="stat" />
              <TextBlock Text="{Binding Note}" Classes="note" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- map -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Button Classes="gold" Command="{Binding PlayPauseCommand}" Content="{Binding PlayText}" MinWidth="72" HorizontalContentAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="10,0">
              <Button Classes="ghost" Content="1x" Command="{Binding SetSpeedCommand}" CommandParameter="1" />
              <Button Classes="ghost" Content="4x" Command="{Binding SetSpeedCommand}" CommandParameter="4" />
              <Button Classes="ghost" Content="16x" Command="{Binding SetSpeedCommand}" CommandParameter="16" />
            </StackPanel>
            <Slider Grid.Column="2" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Time}" VerticalAlignment="Center" Margin="6,0" />
            <TextBlock Grid.Column="3" Text="{Binding ClockText}" Classes="cellnum" Foreground="{DynamicResource InkBrush}" Margin="10,0" MinWidth="90" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
              <ToggleButton Classes="ghost" Content="Follow me" IsChecked="{Binding Follow}" />
              <Button Classes="ghost" Content="Fit" Click="OnFit" />
            </StackPanel>
          </Grid>
        </Border>
        <Panel>
          <c:MapView x:Name="Map" Map="{Binding Map}" Time="{Binding Time}" Follow="{Binding Follow}" MapImage="{Binding MapImage}" Geo="{Binding Geo}" />
          <TextBlock Text="{Binding MapNote}" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" />
          <TextBlock Text="No map data for this match" IsVisible="{Binding !HasMap}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="2" Background="{DynamicResource NavBrush}" Opacity="0.92">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource MapMeBrush}" /><TextBlock Text="you" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource MapMateBrush}" /><TextBlock Text="team" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource MapOtherBrush}" /><TextBlock Text="others" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource MapOpenedBrush}" /><TextBlock Text="opened" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource MapBrokenBrush}" /><TextBlock Text="broken" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource MapStormBrush}" /><TextBlock Text="storm" Classes="muted" /></StackPanel>
            </StackPanel>
          </Border>
        </Panel>
      </DockPanel>
    </Border>

    <!-- side column: the match, told three ways -->
    <ScrollViewer Grid.Row="2" Grid.Column="2">
      <StackPanel Margin="0,0,10,0">
        <Border Classes="rule" />
        <TextBlock Classes="kicker" Text="KNOCKS AND ELIMINATIONS" Margin="0,12,0,6" />
        <ItemsControl ItemsSource="{Binding Fights}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FightLine">
              <Button Classes="link" Padding="4,7"
                      Command="{Binding $parent[UserControl].((vm:MatchDetailViewModel)DataContext).JumpCommand}" CommandParameter="{Binding T}">
                <Grid ColumnDefinitions="52,*">
                  <TextBlock Text="{Binding Time}" Classes="cellnum" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Text}" Classes="rowname" FontSize="17" />
                    <TextBlock Text="{Binding Detail}" Classes="note" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="rule" Margin="0,18,0,0" />
        <TextBlock Classes="kicker" Text="DAMAGE BY WEAPON" Margin="0,12,0,4" />
        <Grid ColumnDefinitions="*,46,46,60" Margin="0,0,0,4">
          <TextBlock Classes="label num" Grid.Column="1" Text="HITS" />
          <TextBlock Classes="label num" Grid.Column="2" Text="HS" />
          <TextBlock Classes="label num" Grid.Column="3" Text="DMG" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Damage}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DamageLine">
              <Border Classes="rowline">
                <Grid ColumnDefinitions="*,46,46,60">
                  <StackPanel Orientation="Horizontal">
                    <Border Classes="rarity" Background="{Binding Rarity, Converter={x:Static vm:RarityBrushConverter.Instance}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Weapon}" Classes="rowname" FontSize="16" MaxWidth="160" />
                      <TextBlock Text="{Binding Detail}" Classes="note" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Hits}" Classes="cellnum" FontSize="16" />
                  <TextBlock Grid.Column="2" Text="{Binding Hs}" Classes="cellnum" FontSize="16" />
                  <TextBlock Grid.Column="3" Text="{Binding Damage}" Classes="cellnum lead" FontSize="16" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding DamageNote}" Classes="note" Margin="0,8,0,0" />

        <Border Classes="rule" Margin="0,18,0,0" />
        <TextBlock Classes="kicker" Text="CHESTS AND LOOT" Margin="0,12,0,6" />
        <ItemsControl ItemsSource="{Binding Chests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChestLine">
              <Button Classes="link" Padding="4,6"
                      Command="{Binding $parent[UserControl].((vm:MatchDetailViewModel)DataContext).JumpCommand}" CommandParameter="{Binding T}">
                <Grid ColumnDefinitions="52,*">
                  <TextBlock Text="{Binding Time}" Classes="cellnum" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding What}" Classes="rowname" FontSize="16" />
                      <TextBlock Text="{Binding Who}" Classes="note" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Loot}" Margin="0,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LootLine">
                          <StackPanel Orientation="Horizontal">
                            <Border Classes="rarity" Width="3" Height="12" Margin="0,0,8,0" Background="{Binding Rarity, Converter={x:Static vm:RarityBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Ink2Brush}" />
                            <TextBlock Text="{Binding Taken}" Classes="muted" Margin="6,0,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
