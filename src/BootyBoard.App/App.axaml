<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BootyBoard.App"
             x:Class="BootyBoard.App.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <!-- The "Night broadcast" look: every brush (dark + light), the fonts and the type sizes live in Looks/Broadcast.axaml,
           so the look can be retuned (or a second one added later) without touching the views. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BootyBoard/Looks/Broadcast.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- brand mark: a drop pin, drawn on a 100x100 box (masthead + page watermark) -->
      <StreamGeometry x:Key="BrandMark">F0 M50,4 C27,4 12,21 12,42 C12,66 50,96 50,96 C50,96 88,66 88,42 C88,21 73,4 50,4 Z M50,27 A15,15 0 1 1 49.99,27 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <!-- type scale -->
    <Style Selector="TextBlock.display">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource DisplaySize}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource DisplayLetterSpacing}" />
    </Style>
    <Style Selector="TextBlock.hero">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource HeroSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
      <Setter Property="Foreground" Value="{DynamicResource HeroBrush}" />
    </Style>
    <Style Selector="TextBlock.heroHeadline">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource HeroHeadlineSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource StatWeight}" />
      <Setter Property="FontStyle" Value="{DynamicResource HeroHeadlineStyle}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource DisplayLetterSpacing}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.headline">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource HeadlineSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource DisplayLetterSpacing}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.headlineSmall">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource HeadlineSmallSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource DisplayLetterSpacing}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.brand">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource BrandSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource DisplayLetterSpacing}" />
    </Style>
    <Style Selector="TextBlock.navTitle">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource NavTitleSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource StatWeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource DisplayLetterSpacing}" />
    </Style>
    <Style Selector="TextBlock.daynum">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource DayNumSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
    </Style>
    <!-- h1/h2 kept as aliases so any older markup still lands on the broadcast scale -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource DisplaySize}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.1" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.dek">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.stat">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource StatSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource StatWeight}" />
    </Style>
    <Style Selector="TextBlock.rowstat">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="{DynamicResource RowStatSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource StatWeight}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- table rows: condensed names and figures, scoreboard style -->
    <Style Selector="TextBlock.rowname">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="{DynamicResource StatWeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cellnum">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="{DynamicResource StatWeight}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>
    <Style Selector="TextBlock.cellnum.lead">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
    </Style>
    <Style Selector="Border.rarity">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.th">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.1" />
    </Style>

    <!-- rules and surfaces: editorial pages use hairlines, panels only where content needs a frame -->
    <Style Selector="Border.rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="Border.goldrule">
      <Setter Property="Height" Value="{DynamicResource RuleHeight}" />
      <Setter Property="Background" Value="{DynamicResource RuleBrush}" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="Padding" Value="18,2,18,4" />
    </Style>
    <Style Selector="Border.rowline">
      <Setter Property="BorderBrush" Value="{DynamicResource GridBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,9" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.watermark">
      <Setter Property="Data" Value="{StaticResource BrandMark}" />
      <Setter Property="Fill" Value="{DynamicResource WatermarkBrush}" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- section banner: a skewed accent tag (a broadcast chyron) and a rule running off to the right -->
    <Style Selector="Label.section">
      <Setter Property="Margin" Value="0,30,0,16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*">
            <Border Background="{DynamicResource AccentBrush}" Padding="14,3,16,2" Margin="6,0,0,0">
              <Border.RenderTransform><SkewTransform AngleX="-14" /></Border.RenderTransform>
              <ContentPresenter Content="{TemplateBinding Content}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="17"
                                Foreground="{DynamicResource OnAccentBrush}">
                <ContentPresenter.RenderTransform><SkewTransform AngleX="14" /></ContentPresenter.RenderTransform>
              </ContentPresenter>
            </Border>
            <Border Grid.Column="1" Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="-2,0,0,0" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- pick card: rarity/accent bar on top, kicker, name, big figure, one line of context -->
    <Style Selector="Border.pick">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,14,18,16" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Width" Value="324" />
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.pick:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>
    <Style Selector="TextBlock.pickValue">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="46" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource HeroBrush}" />
      <Setter Property="LineHeight" Value="48" />
    </Style>

    <!-- strength / weakness / tip notes -->
    <Style Selector="Border.note">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="16,12,18,14" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Width" Value="324" />
    </Style>

    <!-- buttons -->
    <Style Selector="Button.gold">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Button.gold:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.ghost, ToggleButton.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- navigation: text list, brass bar marks the current section -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navTitle">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
