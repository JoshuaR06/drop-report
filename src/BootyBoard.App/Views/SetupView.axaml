<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootyBoard.App.ViewModels"
             xmlns:gd="using:BootyBoard.GameData"
             x:Class="BootyBoard.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <ScrollViewer>
    <StackPanel Margin="40,36" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
      <!-- 1. welcome -->
      <StackPanel Spacing="16" IsVisible="{Binding StepWelcome}">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="/Assets/bootyboard.png" Width="64" Height="64" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Ahoy! Welcome to Booty Board" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Classes="sub" Text="Treasure-season tracking from your own replay files." />
          </StackPanel>
        </StackPanel>
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="HOW IT WORKS" Margin="0" />
            <TextBlock TextWrapping="Wrap" Text="Your game saves a replay file after every match. Booty Board reads those files (only after the match is over) and builds your stats: chests for you and your team, Rare and Sprite Chests, treasure items, weapons, knocks and eliminations, and a playable map of each match." />
            <TextBlock TextWrapping="Wrap" Text="It never touches the running game, never reads game memory and never sends your data anywhere." Classes="sub" />
          </StackPanel>
        </Border>
        <Button Classes="gold" Content="Let's go" Command="{Binding NextCommand}" />
      </StackPanel>

      <!-- 2. real item names -->
      <StackPanel Spacing="14" IsVisible="{Binding StepNames}">
        <TextBlock Text="Real item names" FontSize="26" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Text="Replays only contain internal code names (like WID_Assault_Heavy_Recoil_Athena_VR). To show the names you see in game, Booty Board reads the item list from your installed game's own files. That needs three small public downloads for your game version:" />
        <Border Classes="card">
          <ItemsControl ItemsSource="{Binding Downloads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="gd:Download">
                <Border Classes="rowline">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding What}" />
                      <TextBlock Text="{Binding Source}" Classes="muted" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ApproxSize}" Classes="sub" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock Classes="sub" TextWrapping="Wrap" Text="{Binding GameText}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="This reads files on disk only, never the running game. After a game update, do this again from Settings." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="gold" Content="Download and build names" Command="{Binding BuildNamesCommand}" IsEnabled="{Binding GameFound}" />
          <Button Classes="ghost" Content="Skip (use code names)" Command="{Binding SkipNamesCommand}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Working}" Height="3" />
        <TextBlock Text="{Binding Progress}" Classes="sub" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource MapKillBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 3. import -->
      <StackPanel Spacing="14" IsVisible="{Binding StepImport}">
        <TextBlock Text="Import your matches" FontSize="26" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Text="Fortnite keeps only your last 100 replays. Booty Board saves a copy of each one so your history isn't lost, then reads them (about a second per match, at low priority)." />
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ReplayFolderText}" TextWrapping="Wrap" />
            <TextBlock Text="Kept older replays somewhere else? Add that folder too:" Classes="sub" />
            <ItemsControl ItemsSource="{Binding ExtraFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="sub" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="ghost" Content="Add a folder" Click="OnAddFolder" />
          </StackPanel>
        </Border>
        <Button Classes="gold" Content="Import and read my matches" Command="{Binding ImportCommand}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Working}" Height="3" />
        <TextBlock Text="{Binding Progress}" Classes="sub" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource MapKillBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
