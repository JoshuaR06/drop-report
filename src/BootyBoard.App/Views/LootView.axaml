<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootyBoard.App.ViewModels"
             x:Class="BootyBoard.App.Views.LootView"
             x:DataType="vm:LootViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="CountRow" x:DataType="vm:CountLine">
      <Border Classes="rowline">
        <Grid ColumnDefinitions="*,Auto,50">
          <StackPanel Orientation="Horizontal">
            <Border Classes="swatch" Background="{Binding Rarity, Converter={x:Static vm:RarityBrushConverter.Instance}}" />
            <TextBlock Text="{Binding Name}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="muted" VerticalAlignment="Center" Margin="10,0" />
          <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="num" FontWeight="SemiBold" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16" MaxWidth="1240">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="Loot &amp; treasure" />
          <TextBlock Classes="sub" Text="Chest types, the season's treasure items, and what you took." />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding Main.Filter.Seasons}" SelectedItem="{Binding Main.Filter.Season}" MinWidth="180" />
          <ComboBox ItemsSource="{Binding Main.Filter.Modes}" SelectedItem="{Binding Main.Filter.Mode}" MinWidth="130" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,16,*">
        <StackPanel Spacing="16">
          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="h2" Text="CHESTS BY TYPE (YOU + TEAM)" />
              <ItemsControl ItemsSource="{Binding ChestTypes}" ItemTemplate="{StaticResource CountRow}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="h2" Text="SEASON ITEMS YOU PICKED UP" />
              <ItemsControl ItemsSource="{Binding SeasonItems}" ItemTemplate="{StaticResource CountRow}" />
              <TextBlock Classes="muted" Text="Treasure keys, treasure maps, Sprite Locators, extractors and vault keys." Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Classes="card" Grid.Column="2" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Classes="h2" Text="LOOT YOU TOOK FROM CHESTS" />
            <ItemsControl ItemsSource="{Binding Loot}" ItemTemplate="{StaticResource CountRow}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
