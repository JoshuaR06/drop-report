<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootyBoard.App.ViewModels"
             x:Class="BootyBoard.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Image Source="/Assets/bootyboard.png" Width="56" Height="56" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Booty Board" />
          <TextBlock Classes="sub" Text="{Binding Version}" />
        </StackPanel>
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="WHAT IT DOES" Margin="0" />
          <TextBlock TextWrapping="Wrap" Text="Booty Board reads the replay files your game saves after each match and turns them into treasure-season tracking (chests for you and your team, Rare and Sprite Chests, treasure items) and the stats the replay viewer doesn't show: weapons with real names, damage and headshots, knocks vs eliminations, how you went down, and a playable map of every match." />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="SAFE BY DESIGN" Margin="0" />
          <TextBlock TextWrapping="Wrap" Text="Booty Board only reads files on disk: finished replay files, and (for item names) the game's own data files. It never reads game memory, never injects anything and never touches the running game, which is what anti-cheat watches for. It doesn't need admin rights, doesn't start with Windows, and sends nothing anywhere: no account, no telemetry." />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="FREE FOREVER" Margin="0" />
          <TextBlock TextWrapping="Wrap" Text="Booty Board is free and open source. If it helps you, you can support development; it never unlocks anything." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="gold" Content="Support Booty Board" Command="{Binding DonateCommand}" IsVisible="{Binding HasDonation}" />
            <Button Classes="ghost" Content="Source code" Command="{Binding RepoCommand}" IsVisible="{Binding HasRepo}" />
            <Button Classes="ghost" Content="Open-source licenses" Command="{Binding LicensesCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="NOT AFFILIATED WITH EPIC GAMES" Margin="0" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Disclaimer}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Built with FortniteReplayReader (MIT), CUE4Parse (Apache-2.0) and Avalonia (MIT)." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
