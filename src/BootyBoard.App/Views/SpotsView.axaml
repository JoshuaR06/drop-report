<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootyBoard.App.ViewModels"
             xmlns:c="using:BootyBoard.App.Controls"
             x:Class="BootyBoard.App.Views.SpotsView"
             x:DataType="vm:SpotsViewModel">
  <ScrollViewer>
    <StackPanel Margin="48,34,48,40" MaxWidth="1180">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Text="{Binding Dateline}" Classes="kicker" VerticalAlignment="Bottom" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Main.Filter.Seasons}" SelectedItem="{Binding Main.Filter.Season}" MinWidth="176" />
          <ComboBox ItemsSource="{Binding Main.Filter.Modes}" SelectedItem="{Binding Main.Filter.Mode}" MinWidth="124" />
        </StackPanel>
      </Grid>
      <Border Classes="goldrule" />
      <TextBlock Text="Where you should land" Classes="display" Margin="0,16,0,4" />
      <TextBlock Text="Every drop, scored on where you finished, what you fought and what you looted." Classes="dek" Margin="0,0,0,8" />

      <Label Classes="section" Content="THE PICKS" />
      <ItemsControl ItemsSource="{Binding Picks}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PickCard">
            <Border Classes="pick">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" Classes="kicker" />
                <TextBlock Text="{Binding Name}" Classes="headline" TextTrimming="CharacterEllipsis" />
                <c:Ticker Value="{Binding Value}" Classes="pickValue" />
                <TextBlock Text="{Binding Detail}" Classes="note" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Label Classes="section" Content="YOUR DROPS ON THE MAP" />
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <c:SpotMap Height="430" MapImage="{Binding MapImage}" Geo="{Binding Geo}" Spots="{Binding Dots}" />
      </Border>
      <TextBlock Classes="note" Margin="0,6,0,0" Text="Bubble size = how often you drop there. Brighter = better average placement. Hover a bubble for its numbers." />

      <Label Classes="section" Content="EVERY SPOT" />
      <Grid ColumnDefinitions="*,70,170,80,80,80,100" Margin="0,0,0,6">
        <TextBlock Classes="label" Text="LANDED AT" />
        <TextBlock Classes="label num" Grid.Column="1" Text="DROPS" />
        <TextBlock Classes="label" Grid.Column="2" Text="AVG PLACE" Margin="18,0,0,0" />
        <TextBlock Classes="label num" Grid.Column="3" Text="TOP 10" />
        <TextBlock Classes="label num" Grid.Column="4" Text="ELIMS" />
        <TextBlock Classes="label num" Grid.Column="5" Text="CHESTS" />
        <TextBlock Classes="label num" Grid.Column="6" Text="EARLY OUT" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SpotLine">
            <Border Classes="rowline">
              <Grid ColumnDefinitions="*,70,170,80,80,80,100">
                <TextBlock Text="{Binding Spot}" Classes="rowname" />
                <TextBlock Grid.Column="1" Text="{Binding Drops}" Classes="cellnum lead" />
                <Grid Grid.Column="2" ColumnDefinitions="44,*" Margin="18,0,0,0">
                  <TextBlock Text="{Binding Place}" Classes="cellnum" HorizontalAlignment="Left" Foreground="{DynamicResource InkBrush}" />
                  <c:Meter Grid.Column="1" Value="{Binding PlaceFill}" VerticalAlignment="Center" Margin="0,0,16,0" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding Top10}" Classes="cellnum" />
                <TextBlock Grid.Column="4" Text="{Binding Elims}" Classes="cellnum" />
                <TextBlock Grid.Column="5" Text="{Binding Chests}" Classes="cellnum" />
                <TextBlock Grid.Column="6" Text="{Binding Early}" Classes="cellnum" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="note" Margin="0,12,0,0" MaxWidth="860" HorizontalAlignment="Left" Text="{Binding Note}" />
      <TextBlock Classes="note" Margin="0,4,0,0" MaxWidth="860" HorizontalAlignment="Left" Text="Average place bar: longer is better. Early out = the match ended within 4 minutes of the jump. Elims and chests are per match; chests include your team's." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
