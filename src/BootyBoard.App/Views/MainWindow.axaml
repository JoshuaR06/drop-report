<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BootyBoard.App.ViewModels"
        x:Class="BootyBoard.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Booty Board" Width="1320" Height="860" MinWidth="980" MinHeight="640"
        Icon="/Assets/bootyboard.ico" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="232,*">
    <!-- navigation rail -->
    <Border Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,22">
          <Image Source="/Assets/bootyboard.png" Width="34" Height="34" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Booty Board" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="treasure season tracker" Classes="muted" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Button Classes="gold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ScanCommand}" IsEnabled="{Binding !Busy}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" VerticalAlignment="Center" />
              <TextBlock Text="Scan for new replays" />
            </StackPanel>
          </Button>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Watching}">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource MapOpenedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Watching for new replays" Classes="muted" />
          </StackPanel>
        </StackPanel>
        <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <!-- page -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
  </Grid>
</Window>
