<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootyBoard.App.ViewModels"
             x:Class="BootyBoard.App.Views.WeaponsView"
             x:DataType="vm:WeaponsViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16" MaxWidth="1240">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="Weapons &amp; fights" />
          <TextBlock Classes="sub" Text="Real in-game names. Rarity swatch = the best rarity you used." />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding Main.Filter.Seasons}" SelectedItem="{Binding Main.Filter.Season}" MinWidth="180" />
          <ComboBox ItemsSource="{Binding Main.Filter.Modes}" SelectedItem="{Binding Main.Filter.Mode}" MinWidth="130" />
        </StackPanel>
      </Grid>
      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,70,70,90,70,70,80" Margin="0,0,0,4">
            <TextBlock Classes="th" Text="Weapon" />
            <TextBlock Classes="th num" Grid.Column="1" Text="Elims" />
            <TextBlock Classes="th num" Grid.Column="2" Text="Knocks" />
            <TextBlock Classes="th num" Grid.Column="3" Text="Damage" />
            <TextBlock Classes="th num" Grid.Column="4" Text="Hits" />
            <TextBlock Classes="th num" Grid.Column="5" Text="HS%" />
            <TextBlock Classes="th num" Grid.Column="6" Text="Matches" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WeaponLine">
                <Border Classes="rowline">
                  <Grid ColumnDefinitions="*,70,70,90,70,70,80">
                    <StackPanel Orientation="Horizontal">
                      <Border Classes="swatch" Background="{Binding Rarity, Converter={x:Static vm:RarityBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Elims}" Classes="num" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Knocks}" Classes="num" />
                    <TextBlock Grid.Column="3" Text="{Binding Damage}" Classes="num" />
                    <TextBlock Grid.Column="4" Text="{Binding Hits}" Classes="num" />
                    <TextBlock Grid.Column="5" Text="{Binding Hs}" Classes="num" />
                    <TextBlock Grid.Column="6" Text="{Binding Matches}" Classes="num" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" Text="Knocks and elims come from Epic's elimination events and are complete. Damage and headshots only count hits the replay recorded in detail: slingshot hits arrive blank and melee items (like Leekcapper) send none." />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="HOW YOU WENT DOWN" />
          <TextBlock Classes="sub" Text="{Binding DeathSummary}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Deaths}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CountLine">
                <Border Classes="rowline">
                  <Grid ColumnDefinitions="160,*,60">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="sub" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="num" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
